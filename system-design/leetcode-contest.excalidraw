  "elements": [
    {
      "id": "lMBJ67ALZU6-yM-F9VL5A",
      "type": "text",
      "x": -257.3898162841797,
      "y": -593,
      "width": 1241.6182861328125,
      "height": 189,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
